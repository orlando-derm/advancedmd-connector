{
  "$schema": "amd-mcp-policy/v1.1",
  "action": "getsysdefaults",
  "domain": "system",
  "tier": 1,
  "tool_name": "amd_system_getsysdefaults",
  "redact": {
    "phi_fields": [],
    "non_phi_keep": [
      "category_id",
      "category_name",
      "default_value",
      "category",
      "key",
      "name"
    ],
    "strict_mode_patterns": []
  },
  "permission": {
    "audience": [
      "front_desk",
      "admin"
    ]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": false
  },
  "write_action": false,
  "permitted_actions": [
    "getsysdefaults"
  ]
}
