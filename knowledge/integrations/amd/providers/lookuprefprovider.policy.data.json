{
  "$schema": "amd-mcp-policy/v1.1",
  "action": "lookuprefprovider",
  "domain": "providers",
  "tier": 3,
  "tool_name": "amd_providers_lookuprefprovider",
  "redact": {
    "phi_fields": [
      "first_name",
      "firstname",
      "last_name",
      "lastname",
      "middle_name",
      "middlename"
    ],
    "non_phi_keep": [
      "refprov_id",
      "refprovid",
      "specialty",
      "npi",
      "facility_id"
    ],
    "strict_mode_patterns": [
      ".*_name$"
    ]
  },
  "permission": {
    "audience": [
      "front_desk",
      "admin"
    ]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": true
  },
  "write_action": false,
  "permitted_actions": [
    "lookuprefprovider"
  ]
}
