{
  "$schema": "amd-mcp-policy/v1.1",
  "action": "lookupprofile",
  "domain": "providers",
  "tier": 3,
  "tool_name": "amd_providers_lookupprofile",
  "redact": {
    "phi_fields": [],
    "non_phi_keep": [
      "profile_id",
      "profile_code",
      "profile_name",
      "facility_id",
      "facility_name",
      "finclass_id",
      "finclass_name",
      "provider_id"
    ],
    "strict_mode_patterns": []
  },
  "permission": {
    "audience": [
      "front_desk",
      "admin"
    ]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": false
  },
  "write_action": false,
  "permitted_actions": [
    "lookupprofile"
  ]
}
