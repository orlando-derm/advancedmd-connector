{
  "$schema": "amd-mcp-policy/v1",
  "action": "lookupprovider",
  "domain": "providers",
  "tier": 3,
  "tool_name": "amd_providers_lookup_provider",
  "redact": {
    "phi_fields": [],
    "non_phi_keep": [
      "provider_id", "id",
      "provider_name", "name", "fullname",
      "first_name", "last_name", "middle_name", "title",
      "code", "profilecode", "profile_id",
      "npi", "specialty", "specialty_code",
      "exactmatch", "page",
      "matchcount", "totalmatches"
    ],
    "strict_mode_patterns": []
  },
  "permission": {
    "audience": ["front_desk", "admin"]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": true
  },
  "write_action": false,
  "permitted_actions": ["lookupprovider"]
}
