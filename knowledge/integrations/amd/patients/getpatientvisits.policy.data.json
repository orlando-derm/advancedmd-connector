{
  "$schema": "amd-mcp-policy/v1",
  "action": "getpatientvisits",
  "domain": "patients",
  "tier": 2,
  "tool_name": "amd_patients_get_patient_visits",
  "redact": {
    "phi_fields": ["first_name", "last_name", "dob"],
    "non_phi_keep": [
      "patient_id", "chart_number",
      "appointment_id", "visit_id", "appointment_type",
      "provider_id", "provider_name", "scheduled_date",
      "appointment_datetime", "visit_status"
    ],
    "strict_mode_patterns": [".*_name$"]
  },
  "permission": {
    "audience": ["front_desk", "admin"]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": true
  },
  "write_action": false,
  "permitted_actions": ["getpatientvisits"]
}
