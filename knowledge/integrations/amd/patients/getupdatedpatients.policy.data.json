{
  "$schema": "amd-mcp-policy/v1",
  "action": "getupdatedpatients",
  "domain": "patients",
  "tier": 2,
  "tool_name": "amd_patients_get_updated_patients",
  "redact": {
    "phi_fields": [
      "first_name", "firstname", "last_name", "lastname",
      "dob", "date_of_birth"
    ],
    "non_phi_keep": ["patient_id", "chart_number"],
    "strict_mode_patterns": [".*_name$"]
  },
  "permission": {
    "audience": ["admin"]
  },
  "audit": {
    "always_log": true,
    "log_when_phi_revealed": true
  },
  "write_action": false,
  "permitted_actions": ["getupdatedpatients"]
}
