{
  "$schema": "amd-mcp-policy/v1",
  "action": "getreminderappts",
  "domain": "patients",
  "tier": 2,
  "tool_name": "amd_patients_get_reminder_appts",
  "redact": {
    "phi_fields": ["first_name", "last_name", "phone_home", "phone_cell", "email"],
    "non_phi_keep": [
      "patient_id", "chart_number",
      "appointment_id", "appointment_datetime",
      "appointment_type", "provider_id", "provider_name"
    ],
    "strict_mode_patterns": [".*_name$", ".*phone$"]
  },
  "permission": {
    "audience": ["front_desk", "admin"]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": true
  },
  "write_action": false,
  "permitted_actions": ["getreminderappts"]
}
