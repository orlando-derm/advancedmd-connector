{
  "$schema": "amd-mcp-policy/v1",
  "action": "lookup-patient",
  "domain": "patients",
  "tier": 3,
  "tool_name": "amd_patients_lookup_patient",
  "redact": {
    "phi_fields": [
      "first_name", "firstname", "last_name", "lastname",
      "dob", "date_of_birth", "ssn"
    ],
    "non_phi_keep": ["patient_id", "chart_number"],
    "strict_mode_patterns": [".*_name$"]
  },
  "permission": {
    "audience": ["front_desk", "admin"]
  },
  "audit": {
    "always_log": false,
    "log_when_phi_revealed": true
  },
  "write_action": false,
  "permitted_actions": [["lookuppatient", {"class_": ["api"]}]]
}
