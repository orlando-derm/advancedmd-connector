# advancedmd-connector configuration, SPEC 19.
# PLACEHOLDER VALUES ONLY. Never commit real credentials.
# Copy to .env (gitignored) and fill the three required AMD secrets.

# --- required ---------------------------------------------------------
AMD_USERNAME=REPLACE_ME_AMD_USERNAME
AMD_PASSWORD=REPLACE_ME_AMD_PASSWORD
AMD_OFFICE_KEY=REPLACE_ME_AMD_OFFICE_KEY
CONNECTOR_TOKENS_PATH=/data/tokens.json

# --- optional, defaults shown -----------------------------------------
AMD_APP_NAME=TEMP
# Override only for testing against a non-production AMD endpoint.
AMD_BASE_URL=
CONNECTOR_PORT=8820
CONNECTOR_BIND=0.0.0.0
CLOCK_STATE_PATH=/data/clock.json
# MUST be <= 1.0; startup fails otherwise.
CLOCK_MARGIN=0.90
EXECUTION_ALLOWANCE_MS=120000
BATCH_AGING_MS=60000
AMD_POST_TIMEOUT_S=30
LOGIN_CHECK_CACHE_S=300
ENTRY_QUEUE_CAP=2000
SHUTDOWN_DRAIN_S=30
LOG_LEVEL=INFO
# Global write gate. Per-token may_write is still required on top of this.
WRITE_TOOLS_ENABLED=false
