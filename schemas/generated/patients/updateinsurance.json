{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amd-mcp/schemas/patients/updateinsurance",
  "title": "AMD action: updateinsurance",
  "x-amd-action": {
    "class_": "demographics",
    "domain": "patients",
    "key": "updateinsurance",
    "name": "updateinsurance",
    "phi_touching": true,
    "tier": 2,
    "write": true
  },
  "description": "WRITE STUB: would update an existing insurance plan for a patient (sequence-aware). Hidden by WRITE_TOOLS_ENABLED=False.",
