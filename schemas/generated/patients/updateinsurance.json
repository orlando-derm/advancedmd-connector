    "insplan_id",
    "updates"
  ],
  "properties": {
    "insplan_id": {
      "type": "string",
      "minLength": 1
    },
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "updates": {
      "type": "object"
    }
  }
}
